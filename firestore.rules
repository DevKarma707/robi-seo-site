rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Seul l'admin Robi peut écrire articles / lire visites.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['ralphkaram75014@gmail.com', 'robi@robi-app.com'];
    }

    // ── Articles de blog ──
    // Lecture publique des articles publiés (blog public).
    // L'admin lit aussi les brouillons et peut tout écrire.
    match /articles/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ── Prospects (acquisition) ──
    // Données de prospection : strictement réservées à l'admin, jamais publiques.
    match /prospects/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    // ── Kanban du lancement ──
    match /launchTasks/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    // ── Influenceurs (programme de codes promo) ──
    match /influencers/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    // ── Désinscriptions ──
    // Le lien d'opt-out est cliqué par un destinataire non authentifié : la
    // création doit donc être ouverte, mais bornée à un jeton opaque. Sans ça,
    // l'opt-out ne peut pas fonctionner — et il est obligatoire.
    match /unsubscribes/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['token', 'at'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 8
        && request.resource.data.token.size() < 200;
      allow update, delete: if false;
    }

    // ── Visites (compteur maison) ──
    // N'importe quel visiteur peut créer une visite (write-only, champs limités).
    // Seul l'admin peut lire les statistiques.
    match /visits/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['path', 'source', 'createdAt'])
        && request.resource.data.path is string
        && request.resource.data.source is string;
      allow update, delete: if false;
    }
  }
}
