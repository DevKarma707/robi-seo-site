rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['ralphkaram75014@gmail.com', 'robi@robi-app.com'];
    }

    // Images de couverture des articles de blog :
    // lecture publique, écriture réservée à l'admin (max 10 Mo, images uniquement).
    // NB : une suppression est une écriture où `request.resource` est NUL.
    // Écrite en `allow write` avec une condition de taille, elle échouait
    // toujours — et l'erreur renvoyée est un « unauthorized » opaque, qui
    // laisse croire à un problème de compte. D'où create/update et delete
    // séparés, ici comme sous partage/.
    match /blog/{file=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Dossier de travail partagé avec Claude (onglet Fichiers).
    // Contrairement à blog/, la LECTURE est réservée à l'admin : on y dépose
    // des exports et des documents internes, pas des visuels publics.
    // Aucune restriction de type — c'est un dossier de travail — mais 50 Mo
    // par fichier pour ne pas transformer le bucket en disque dur.
    match /partage/{file=**} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isAdmin();
    }
  }
}
